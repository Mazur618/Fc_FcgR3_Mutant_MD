# Include source explicitly; data/results stay local, including new outputs.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements-analysis.txt
!/environment.yml
!/variants.txt
!/make_p.py
!/mutate.py
!/build.py
!/build_variant.sh
!/dry_info.sh
!/submit_variant.sh
!/post_variant.sh
!/run_all.sh
!/templates/
!/legacy/
!/report/
!/analysis_v2/
!/scripts/
!/docs/
!/.github/
/templates/*
!/templates/*.in
/analysis_v2/*
!/analysis_v2/*.py
!/analysis_v2/README.md
!/analysis_v2/protocol.json
!/analysis_v2/.gitignore
/scripts/*
!/scripts/*.py
!/scripts/*.sh
!/scripts/*.slurm
/docs/*
!/docs/*.md
!/docs/input-manifest.json
!/docs/run-history.csv
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/tests.yml
__pycache__/
*.py[cod]
.env
.env.*

/legacy/*
!/legacy/*.py
!/legacy/*.sh
!/legacy/README.md
!/legacy/analysis/
/legacy/analysis/*
!/legacy/analysis/*.py
!/legacy/analysis/*.cpptraj
/report/*
!/report/index.html
!/report/supplemental.html
!/report/manifest.json
!/report/assets/
/report/assets/*
!/report/assets/*.png
!/report/assets/*.pdf
!/report/assets/*.csv
