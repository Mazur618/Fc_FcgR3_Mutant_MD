# Include source explicitly; data/results stay local, including new outputs.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements-analysis.txt
!/environment.yml
!/variants.txt
!/MD/
!/legacy/
!/report/
!/analysis/
!/slurm/
!/docs/
!/.github/
/MD/*
!/MD/*.in
/analysis/*
!/analysis/__init__.py
!/analysis/io.py
!/analysis/sensitivity.py
!/analysis/README.md
!/analysis/.gitignore
!/analysis/structure/
/analysis/structure/*
!/analysis/structure/__init__.py
!/analysis/structure/trajectory.py
!/analysis/structure/plot_structure.py
!/analysis/mmgbsa/
/analysis/mmgbsa/*
