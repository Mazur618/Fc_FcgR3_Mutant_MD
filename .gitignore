!/analysis/reporting/build_report.py
!/analysis/reporting/report_pages.py
/slurm/*
!/slurm/*.py
!/slurm/*.sh
!/slurm/*.slurm
/docs/*
!/docs/*.md
!/docs/input-manifest.json
!/docs/run-history.csv
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/tests.yml
__pycache__/
*.py[cod]
.env
.env.*

/legacy/*
!/legacy/*.py
!/legacy/*.sh
!/legacy/README.md
!/legacy/analysis/
/legacy/analysis/*
